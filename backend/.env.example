# Copy this file to .env and fill in real values. Never commit .env itself.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave DATABASE_URL empty to fall back to local SQLite during early dev.
# Once Supabase is set up, paste its Postgres connection string here:
# postgresql://postgres:[password]@[host]:[port]/postgres
DATABASE_URL=

# Comma-separated list of origins allowed to call this API (your React dev server / Vercel domain)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
